{
  "name": "UsableNet PageCapture for automated tools",
  "version": "2.0.0.10431",
  "manifest_version": 3,
  "key": "",
  "description": "Capture web pages to be processed by UsableNet AQA from automated testing tools",
  "author": "UsableNet",
  "icons": {
    "128": "icons/icon-128x128.png"
  },
  "background": {
    "service_worker": "background/background-28bfe18bfc30d4cb35f0.bundle.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "contentscripts/overrides-init.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "contentscripts/rt-buffer.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "contentscripts/page-sizes.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "webNavigation",
    "scripting",
    "unlimitedStorage",
    "debugger"
  ],
  "externally_connectable": {
    "matches": [
      "<all_urls>"
    ]
  },
  "version_name": "2.0.0"
}